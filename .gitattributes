# Normalize line endings: the project is developed on Linux.
* text=auto eol=lf

# Benchmark data: readable diffs, but large files.
*.jsonl text
*.csv   text

# Logs are raw evidence: no diffs in commits.
logs/** -diff

# The corpus is generated and large.
bench/corpus/code_corpus.txt      linguist-generated=true
bench/corpus/code_corpus.tokens.json linguist-generated=true
